# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IBM watsonx.ai / Granite (optional)
# If unset, /api/generate falls back to deterministic mock content so the
# app still runs end-to-end without IBM Cloud credentials.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Defaults to https://us-south.ml.cloud.ibm.com if unset
WATSONX_URL=
# Defaults to ibm/granite-3-8b-instruct if unset
WATSONX_MODEL_ID=
